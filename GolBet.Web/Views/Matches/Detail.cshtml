@using GolBet.Entities.Enums
@using GolBet.Web.Helpers
@model GolBet.Services.DTOs.MatchDetailDto

@{
    ViewData["Title"] = $"{Model.HomeTeamName} vs {Model.AwayTeamName}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Partidos</a></li>
        <li class="breadcrumb-item active">@Model.HomeTeamName vs @Model.AwayTeamName</li>
    </ol>
</nav>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>📅 @Model.Date.ToColombiaTime().ToString("dddd dd MMM yyyy · h:mm tt")</span>
        @switch (Model.Status)
        {
            case MatchStatus.Scheduled:
                <span class="badge bg-primary">Programado</span>
                break;
            case MatchStatus.InProgress:
                <span class="badge bg-warning text-dark">En juego</span>
                break;
            case MatchStatus.Finished:
                <span class="badge bg-secondary">Finalizado</span>
                break;
        }
    </div>

    <div class="card-body">
        <div class="d-flex justify-content-around align-items-center text-center py-3">
            <div>
                <img src="@(Model.HomeTeamCrestUrl ?? "https://placehold.co/100x100/e9ecef/6c757d?text=FC")" alt="@Model.HomeTeamName" width="100" height="100" class="mb-2" />
                <h4>@Model.HomeTeamName</h4>
            </div>
            <div class="px-4 text-nowrap">
                @if (Model.Status == MatchStatus.Finished)
                {
                    <span class="display-4 fw-bold">@Model.HomeGoals - @Model.AwayGoals</span>
                }
                else
                {
                    <span class="display-6 text-muted">vs</span>
                }
            </div>
            <div>
                <img src="@(Model.AwayTeamCrestUrl ?? "https://placehold.co/100x100/e9ecef/6c757d?text=FC")" alt="@Model.AwayTeamName" width="100" height="100" class="mb-2" />
                <h4>@Model.AwayTeamName</h4>
            </div>
        </div>

        <hr />
        <h5 class="text-center mb-3">Cuotas</h5>
        <div class="row g-3 justify-content-center">
            <div class="col-md-3"><div class="border rounded text-center py-3"><div class="text-muted">1 · @Model.HomeTeamName</div><div class="fs-3 fw-bold">@Model.HomeOdds.ToString("0.00")</div></div></div>
            <div class="col-md-3"><div class="border rounded text-center py-3"><div class="text-muted">X · Empate</div><div class="fs-3 fw-bold">@Model.DrawOdds.ToString("0.00")</div></div></div>
            <div class="col-md-3"><div class="border rounded text-center py-3"><div class="text-muted">2 · @Model.AwayTeamName</div><div class="fs-3 fw-bold">@Model.AwayOdds.ToString("0.00")</div></div></div>
        </div>
    </div>

    <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <small class="text-muted">🎟️ @Model.TotalBets apuestas realizadas</small>
            @if (User.IsInRole("Admin") && Model.Status == MatchStatus.Scheduled)
            {
                <a class="btn btn-sm btn-outline-primary ms-2" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
            }
        </div>

        @if (Model.Status == MatchStatus.Scheduled && !User.IsInRole("Admin"))
        {
            <button class="btn btn-success" disabled title="La funcionalidad de apuestas corresponde al módulo 8">Apostar (Módulo 8)</button>
        }

        @if (User.IsInRole("Admin"))
        {
            <div class="d-flex gap-2">
                @if (Model.Status == MatchStatus.Scheduled)
                {
                    <form asp-action="Start" method="post" asp-route-id="@Model.Id" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning text-dark">Iniciar partido</button>
                    </form>
                }
                else if (Model.Status == MatchStatus.InProgress)
                {
                    <a asp-action="Close" asp-route-id="@Model.Id" class="btn btn-success">Cerrar partido</a>
                }

                <form asp-action="Deactivate" method="post" asp-route-id="@Model.Id" onsubmit="return confirm('¿Desactivar este partido?')" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">Desactivar partido</button>
                </form>
            </div>
        }
    </div>
</div>