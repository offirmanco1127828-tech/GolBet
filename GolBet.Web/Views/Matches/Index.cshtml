@using GolBet.Entities.Enums
@using GolBet.Web.Helpers
@model IEnumerable<GolBet.Services.DTOs.MatchDto>

@{
    ViewData["Title"] = "Partidos";
    var current = (MatchStatus?)ViewBag.CurrentStatus;
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Partidos</h1>
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-success" asp-action="Create">+ Nuevo partido</a>
        }
    </div>

    <div class="d-flex gap-2 flex-wrap mb-4">
        <a asp-action="Index" class="btn btn-sm @(current is null ? "btn-success" : "btn-outline-success")">Todos</a>
        <a asp-action="Index" asp-route-status="@MatchStatus.Scheduled" class="btn btn-sm @(current == MatchStatus.Scheduled ? "btn-success" : "btn-outline-success")">Programados</a>
        <a asp-action="Index" asp-route-status="@MatchStatus.InProgress" class="btn btn-sm @(current == MatchStatus.InProgress ? "btn-success" : "btn-outline-success")">En juego</a>
        <a asp-action="Index" asp-route-status="@MatchStatus.Finished" class="btn btn-sm @(current == MatchStatus.Finished ? "btn-success" : "btn-outline-success")">Finalizados</a>
    </div>

    <div class="row g-4">
        @foreach (var match in Model)
        {
            var statusText = match.Status switch
            {
                MatchStatus.Scheduled => "Programado",
                MatchStatus.InProgress => "En juego",
                MatchStatus.Finished => "Finalizado",
                _ => "Desconocido"
            };

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header text-white fw-bold d-flex justify-content-between"
                         style="background: linear-gradient(115deg, @match.HomeTeamColor 48%, #212529 50%, @match.AwayTeamColor 52%);">
                        <span>@match.HomeTeamName</span>
                        <span>VS</span>
                        <span>@match.AwayTeamName</span>
                    </div>

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-secondary">@statusText</span>
                            <small>@match.Date.ToColombiaTime().ToString("dd/MM/yyyy HH:mm")</small>
                        </div>

                        <div class="text-center">
                            @if (!string.IsNullOrWhiteSpace(match.HomeTeamCrestUrl))
                            {
                                <img src="@match.HomeTeamCrestUrl" alt="@match.HomeTeamName" width="50" height="50" />
                            }
                            <div><strong>@match.HomeTeamName</strong></div>
                            <div class="my-2 fs-4">@(match.HomeGoals?.ToString() ?? "-") <span class="mx-2">-</span> @(match.AwayGoals?.ToString() ?? "-")</div>
                            <div><strong>@match.AwayTeamName</strong></div>
                            @if (!string.IsNullOrWhiteSpace(match.AwayTeamCrestUrl))
                            {
                                <img src="@match.AwayTeamCrestUrl" alt="@match.AwayTeamName" width="50" height="50" />
                            }
                        </div>

                        <hr />

                        <div class="row text-center">
                            <div class="col"><small>1</small><br /><strong>@match.HomeOdds.ToString("0.00")</strong></div>
                            <div class="col"><small>X</small><br /><strong>@match.DrawOdds.ToString("0.00")</strong></div>
                            <div class="col"><small>2</small><br /><strong>@match.AwayOdds.ToString("0.00")</strong></div>
                        </div>

                        <a asp-action="Detail" asp-route-id="@match.Id" class="btn btn-sm btn-outline-secondary w-100 mt-2">Ver detalle</a>

                        @if (User.IsInRole("Admin") && match.Status != MatchStatus.Finished)
                        {
                            <form asp-action="FinishMatch" method="post" class="mt-2 pt-2 border-top">
                                <input type="hidden" name="id" value="@match.Id" />
                                <div class="input-group input-group-sm">
                                    <input type="number" name="homeGoals" class="form-control" placeholder="Local" min="0" required />
                                    <input type="number" name="awayGoals" class="form-control" placeholder="Visita" min="0" required />
                                    <button type="submit" class="btn btn-danger">Finalizar</button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>