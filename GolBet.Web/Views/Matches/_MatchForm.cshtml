@model GolBet.Services.DTOs.MatchFormDto
<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3"><label asp-for="HomeTeamId" class="form-label">Equipo local</label><select asp-for="HomeTeamId" asp-items="ViewBag.Teams" class="form-select"><option value="0">Selecciona el equipo local</option></select><span asp-validation-for="HomeTeamId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="AwayTeamId" class="form-label">Equipo visitante</label><select asp-for="AwayTeamId" asp-items="ViewBag.Teams" class="form-select"><option value="0">Selecciona el equipo visitante</option></select><span asp-validation-for="AwayTeamId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Date" class="form-label">Fecha y hora (Colombia)</label><input asp-for="Date" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /><span asp-validation-for="Date" class="text-danger"></span></div>
<div class="row"><div class="col-md-4 mb-3"><label asp-for="HomeOdds" class="form-label">Cuota local</label><input asp-for="HomeOdds" type="number" step="0.01" min="1.01" class="form-control" /><span asp-validation-for="HomeOdds" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="DrawOdds" class="form-label">Cuota empate</label><input asp-for="DrawOdds" type="number" step="0.01" min="1.01" class="form-control" /><span asp-validation-for="DrawOdds" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="AwayOdds" class="form-label">Cuota visitante</label><input asp-for="AwayOdds" type="number" step="0.01" min="1.01" class="form-control" /><span asp-validation-for="AwayOdds" class="text-danger"></span></div></div>
<button type="submit" class="btn btn-success">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
