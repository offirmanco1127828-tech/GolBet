@model IEnumerable<GolBet.Services.DTOs.TeamDto>

@{
    ViewData["Title"] = "Equipos";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Equipos</h1>
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-success" asp-action="Create">+ Nuevo equipo</a>
        }
    </div>

    <div class="row g-4">
        @foreach (var team in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header text-white fw-bold d-flex align-items-center justify-content-between"
                         style="background-color: @(string.IsNullOrWhiteSpace(team.PrimaryColor) ? "#007A33" : team.PrimaryColor);">
                        <span>@team.Name</span>
                        <span class="badge bg-dark bg-opacity-50">@team.PrimaryColor</span>
                    </div>

                    <div class="card-body d-flex flex-column justify-content-between">
                        <div class="text-center mb-3">
                            @if (!string.IsNullOrWhiteSpace(team.CrestUrl))
                            {
                                <img src="@team.CrestUrl" alt="@team.Name" width="60" height="60" class="mb-2" />
                            }
                            <div class="text-muted">@team.City</div>
                        </div>

                        @if (User.IsInRole("Admin"))
                        {
                            <div class="d-flex gap-2 mt-2 pt-2 border-top">
                                <a asp-action="Edit" asp-route-id="@team.Id" class="btn btn-sm btn-outline-primary w-100">Editar</a>
                                <form asp-action="Deactivate" asp-route-id="@team.Id" method="post" class="w-100">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">Desactivar</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>