@using GolBet.Entities
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>@ViewData["Title"] - GolBet</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css"/></head><body><header><nav class="navbar navbar-expand-sm navbar-dark bg-success border-bottom mb-3"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">⚽ GolBet</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="mainNav"><ul class="navbar-nav me-auto"><li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li><li class="nav-item"><a class="nav-link" asp-controller="Matches" asp-action="Index">Partidos</a></li><li class="nav-item"><a class="nav-link" asp-controller="Teams" asp-action="Index">Equipos</a></li>@if (User.IsInRole("Admin")) { <li class="nav-item"><a class="nav-link" asp-controller="Matches" asp-action="Create">Nuevo partido</a></li> }</ul><ul class="navbar-nav ms-auto">@if (User.Identity?.IsAuthenticated == true) { var account = await UserManager.GetUserAsync(User); <li class="nav-item"><span class="navbar-text text-white me-3">Hola, @(account?.FullName ?? User.Identity.Name) · @((account?.Balance ?? 0).ToString("C0"))</span></li><li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="btn btn-outline-light btn-sm mt-1">Cerrar sesión</button></form></li> } else { <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Iniciar sesión</a></li><li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Registrarse</a></li> }</ul></div></div></nav></header><div class="container"><main class="pb-3">@if (TempData["Success"] is string success) { <div class="alert alert-success alert-dismissible fade show" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div> }@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div>}@RenderBody()</main></div><footer class="border-top footer text-muted mt-5"><div class="container py-3">GolBet · Simulador académico con monedas virtuales FutCoins · @DateTime.Now.Year</div></footer><script src="https://code.jquery.com/jquery-3.7.1.min.js"></script><script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script><script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
